<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingTop="18dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/ArtVerse.Text.Section"
        android:textSize="15sp"
        tools:text="Digital Art" />

    <TextView
        android:id="@+id/tvCategoryCount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/text_hint"
        android:textSize="12sp"
        tools:text="3 pieces" />

    <TextView
        android:id="@+id/tvDownloadableHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_circle_accent"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="@string/digital_badge"
        android:textColor="@color/brand_primary"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
