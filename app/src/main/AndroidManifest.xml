<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Receipt PDF download on Android 9 and below (10+ uses MediaStore). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ArtVerse"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ArtVerse.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".auth.LoginActivity" android:exported="false" />
        <activity android:name=".auth.RoleSelectionActivity" android:exported="false" />
        <activity android:name=".auth.CustomerRegisterActivity" android:exported="false" />
        <activity android:name=".auth.ArtistRegisterActivity" android:exported="false" />

        <activity
            android:name=".customer.CustomerMainActivity"
            android:exported="false" />
        <activity android:name=".customer.ArtworkDetailActivity" android:exported="false" />
        <activity android:name=".customer.CheckoutActivity" android:exported="false" />

        <activity
            android:name=".artist.ArtistMainActivity"
            android:exported="false" />
        <activity android:name=".artist.ArtistPendingActivity" android:exported="false" />
        <activity android:name=".artist.AddEditArtworkActivity" android:exported="false" />
        <activity android:name=".artist.ArtistProfileEditActivity" android:exported="false" />

        <activity android:name=".common.ReceiptActivity" android:exported="false" />

    </application>
</manifest>
