<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Receipt PDF and digital-artwork downloads on Android 9 and below
         (10+ uses MediaStore, which needs no permission). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.ArtVerse"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.ArtVerse.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".auth.LoginActivity" android:exported="false" />
        <activity android:name=".auth.RoleSelectionActivity" android:exported="false" />
        <activity android:name=".auth.CustomerRegisterActivity" android:exported="false" />
        <activity android:name=".auth.ArtistRegisterActivity" android:exported="false" />

        <activity
            android:name=".customer.CustomerMainActivity"
            android:exported="false" />
        <activity android:name=".customer.ArtworkDetailActivity" android:exported="false" />
        <activity android:name=".customer.CheckoutActivity" android:exported="false" />
        <activity android:name=".customer.MyCollectionActivity" android:exported="false" />
        <!-- Full-screen look at an owned piece; dark chrome so the artwork
             is not framed by the cream canvas used everywhere else. -->
        <activity
            android:name=".customer.ArtworkViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.ArtVerse.Viewer" />

        <activity
            android:name=".artist.ArtistMainActivity"
            android:exported="false" />
        <activity android:name=".artist.ArtistPendingActivity" android:exported="false" />
        <activity android:name=".artist.AddEditArtworkActivity" android:exported="false" />
        <activity android:name=".artist.ArtistProfileEditActivity" android:exported="false" />
        <activity android:name=".artist.ArtistReportsActivity" android:exported="false" />

        <activity android:name=".common.ReceiptActivity" android:exported="false" />

        <!-- Receives order pushes. Delivers them while the app is closed:
             Android renders the tray notification itself and the tap re-enters
             through SplashActivity, which owns the session check. -->
        <service
            android:name=".services.ArtVerseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel/icon used for notifications Android renders on our behalf
             (app closed or backgrounded); must match NotificationRouter. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="artverse_orders" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_orders" />

    </application>
</manifest>
